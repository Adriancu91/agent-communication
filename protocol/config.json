{
  "protocol_version": "1.1",
  "agents": {
    "gepeto": {"role": "Director strategic", "runtimes": ["openai-api", "chatgpt-ui", "codex", "sim", "system"]},
    "claudiu": {"role": "Director tehnic", "runtimes": ["claude-code", "sim", "system"]},
    "adrian": {"role": "Proprietar (om)", "runtimes": ["human"]},
    "system": {"role": "Automatizare (reguli, costuri)", "runtimes": ["system"]}
  },
  "identities": {
    "_info": "Contul GitHub care a urcat schimbarea (din jurnalul de activitate GitHub, nu din numele autorului) -> principal. Numele aplicațiilor GitHub se completează la activare.",
    "Adriancu91": "adrian",
    "github-actions[bot]": "automation",
    "gepeto-agent-adriancu91[bot]": "gepeto",
    "claudiu-agent-adriancu91[bot]": "claudiu"
  },
  "principals": {
    "gepeto": {
      "write": ["messages/", "logs/events.jsonl", "logs/usage.jsonl", "memory/proposals/", "inbox/", "outbox/", "discussions/"],
      "may_write_as": [{"from": "gepeto", "runtime_prefix": ["openai-api:", "system"]}]
    },
    "claudiu": {
      "write": ["messages/", "logs/events.jsonl", "inbox/", "outbox/", "discussions/", "decisions/DEC-", "tasks/", "research/", "memory/claudiu.md", "memory/proposals/"],
      "may_write_as": [{"from": "claudiu", "runtime_prefix": ["claude-code", "system"]}]
    },
    "automation": {
      "write": ["messages/", "logs/", "inbox/", "outbox/", "discussions/", "protocol/PAUSE"],
      "may_write_as": [{"from": "gepeto", "runtime_prefix": ["sim"]}, {"from": "claudiu", "runtime_prefix": ["sim"]}, {"from": "system", "runtime_prefix": ["system"]}]
    },
    "adrian": {
      "write": ["*"],
      "may_write_as": [{"from": "adrian", "runtime_prefix": ["human"]}, {"from": "gepeto", "runtime_prefix": ["chatgpt-ui", "sim"]}, {"from": "claudiu", "runtime_prefix": ["claude-code", "sim"]}]
    }
  },
  "limits": {
    "max_auto_turns_per_thread": 8,
    "max_messages_per_agent_per_day": 20,
    "max_items_per_run": 3,
    "max_body_chars": 20000,
    "history_messages_in_context": 12,
    "openai_monthly_budget_usd": 5,
    "openai_stop_fraction": 0.9,
    "openai_max_cost_per_call_usd": 0.05,
    "openai_max_output_tokens": 4000
  },
  "priorities": ["low", "normal", "high", "urgent"],
  "types": [
    "message", "question", "proposal", "counterargument", "evaluation", "decision-request", "decision",
    "task", "report", "memory-proposal", "ack", "escalation", "correction", "system"
  ],
  "statuses": ["open", "answered", "accepted", "rejected", "blocked", "closed", "needs-adrian"],
  "protected_paths": ["protocol/", ".github/", "tools/", "agents/", "tests/", "README.md", ".gitignore"],
  "owner_only_paths": ["decisions/approvals/", "memory/gepeto.md", "memory/shared.md"],
  "immutable_paths": ["messages/", "decisions/DEC-", "decisions/approvals/DEC-", "logs/costs/", "memory/proposals/"],
  "append_only_files": ["logs/events.jsonl", "logs/usage.jsonl"],
  "pause_file": "protocol/PAUSE",
  "r3_action_words": [
    "cumpără", "cumpar", "plătește", "plateste", "achiziționează", "abonează", "cheltuie",
    "publică", "publica pe", "lansează public", "deploy", "pune în producție", "șterge", "sterge",
    "trimite email", "contactează clientul", "date de clienți", "datele clienților", "cheie api", "token",
    "modifică regulile", "schimbă regulile", "dezactivează gardianul", "scoate pauza"
  ]
}
